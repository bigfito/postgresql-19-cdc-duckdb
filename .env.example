# =============================================================================
# ElastiFlix CDC Lakehouse Lab: variables de entorno
# =============================================================================
# Plantilla versionada. Para usarla, cópiala como .env en la raíz del
# repositorio; .env no se versiona (está en .gitignore).
#
# Los valores son de laboratorio: sirven para levantar el entorno tal cual en
# una máquina local con los puertos ligados a 127.0.0.1. Quien exponga el
# laboratorio fuera de su máquina debe cambiarlos (diseño, sección 45.5).
#
# Formato: una variable por línea, VARIABLE=valor, sin comillas ni espacios
# alrededor del signo igual.

# -----------------------------------------------------------------------------
# PostgreSQL operacional (diseño, secciones 10 y 45.3)
# -----------------------------------------------------------------------------
# Superusuario postgres. Solo lo usan los scripts de postgresql/init/.
POSTGRES_PASSWORD=uu0XhycSogYnzvh0xhe5oRpt
# Cuenta elastiflix_app: el Event Simulator.
ELASTIFLIX_APP_PASSWORD=_dF2sR3CyzV3a84O97tBNtTK
# Cuenta elastiflix_cdc: Flink CDC.
ELASTIFLIX_CDC_PASSWORD=e76pNAtb3jfLJFNl2YvmYLPm

# -----------------------------------------------------------------------------
# metadata-db: metadatos de Airflow y Superset (diseño, sección 45.3)
# -----------------------------------------------------------------------------
# Superusuario postgres. Solo lo usan los scripts de metadata-db/init/.
METADATA_DB_PASSWORD=DsUtqnsNgNY6vTVVf8k7qHYi
# Cuenta airflow, dueña de la base airflow.
AIRFLOW_DB_PASSWORD=jRkXis4bGb02-MwnISOe5Dgk
# Cuenta superset, dueña de la base superset.
SUPERSET_DB_PASSWORD=-q5IQfk_LNdSQMLucb5-D6Tr

# -----------------------------------------------------------------------------
# RustFS (diseño, secciones 15 y 45.3)
# -----------------------------------------------------------------------------
# Una sola clave para todos los clientes. El Compose la entrega a cada
# contenedor como AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY. También es la
# cuenta de la consola web (http://127.0.0.1:9001).
RUSTFS_ACCESS_KEY=elastiflix-9f740c141d78
RUSTFS_SECRET_KEY=nVVATftRX63fdJHimLKiM-fToD4iwyxdFTd2oOrR
# Región que firman los clientes S3. RustFS no la usa para nada más.
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Administradores de las herramientas (diseño, sección 45.4)
# -----------------------------------------------------------------------------
# Airflow, http://127.0.0.1:8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=zHenoLUYtZHzseb1Midg7PN_
# Superset, http://127.0.0.1:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=mLAAm1kVkYIXZodr7bSqbqT7

# -----------------------------------------------------------------------------
# Secretos internos (diseño, sección 45.3)
# -----------------------------------------------------------------------------
# Airflow: secreto JWT que comparten sus servicios, clave de la API y clave
# Fernet (32 bytes en base64 url-safe, el formato de Fernet.generate_key()).
AIRFLOW_JWT_SECRET=UpO-cspfONmcvSDsaXoxf68griyqFyf0_qyNlYPdZKQ
AIRFLOW_API_SECRET_KEY=Mdi7-3rgCOp7MeXWl-8E9DzyzSw4XrfaSFTVyr8yZo0
AIRFLOW_FERNET_KEY=DRYeexkKhnDIyzQ_wVLnTweHwTaGdu4frUNA2islXsE=
# Superset: firma las cookies de sesión y cifra lo que guarda en metadata-db.
SUPERSET_SECRET_KEY=d6P6PrqLqt2NTVlaixwTBG8EZEv4aj-K2fyNUOGAWEs_YWDl3fzAiS9f

# -----------------------------------------------------------------------------
# Puertos del host (diseño, sección 39)
# -----------------------------------------------------------------------------
# Todos se publican solo en 127.0.0.1. Si alguno ya está ocupado en la
# máquina, cámbialo aquí; las conexiones entre servicios no dependen de ellos.
POSTGRES_HOST_PORT=5432
FLINK_UI_HOST_PORT=8081
SPARK_UI_HOST_PORT=8082
AIRFLOW_HOST_PORT=8080
SUPERSET_HOST_PORT=8088
RUSTFS_API_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
ICEBERG_REST_HOST_PORT=8181

# -----------------------------------------------------------------------------
# Event Simulator (diseño, sección 9.6)
# -----------------------------------------------------------------------------
# Las cuatro primeras se pueden cambiar después desde la interfaz.
# Intervalo entre transacciones, en milisegundos.
SIMULATOR_DELAY_MS=250
# Pesos de INSERT, UPDATE y DELETE.
SIMULATOR_INSERT_WEIGHT=70
SIMULATOR_UPDATE_WEIGHT=25
SIMULATOR_DELETE_WEIGHT=5
# Semilla de la secuencia automática.
SIMULATOR_RANDOM_SEED=42
# Seguir generando cambios al agotar movie.csv.
SIMULATOR_CONTINUOUS=true
# Empezar a simular al arrancar, o esperar en pausa.
SIMULATOR_AUTOSTART=true
# Seguimiento de cada cambio hasta Bronze.
SIMULATOR_TRACK_BRONZE=true
# Intervalo de sondeo de Bronze, en milisegundos.
SIMULATOR_TRACK_INTERVAL_MS=5000
# Tiempo tras el que una transacción pendiente se marca «demorada».
SIMULATOR_TRACK_LATE_MS=120000
# Límites de DuckDB dentro del simulador.
SIMULATOR_DUCKDB_THREADS=2
SIMULATOR_DUCKDB_MEMORY_LIMIT=128MB
