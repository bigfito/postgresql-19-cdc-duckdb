    {
      "id": "jobSilver",
      "lane": "spark",
      "col": 1,
      "type": "messagebus",
      "label": "bronze_to_silver.py",
      "sublabel": "dims, hechos, bridges"
    },
    {
      "id": "jobGold",
      "lane": "spark",
      "col": 3,
      "type": "messagebus",
      "label": "silver_to_gold.py",
      "sublabel": "productos analíticos"
    },
    {
      "id": "bronze",
      "lane": "lake",
      "col": 0,
      "type": "database",
      "label": "bronze.*",
      "sublabel": "escrita por Flink CDC"
    },
    {
      "id": "silver",
      "lane": "lake",
      "col": 2,
      "type": "database",
      "label": "silver.*",
      "sublabel": "estrella + SCD2"
    },
    {
      "id": "gold",
      "lane": "lake",
      "col": 4,
      "type": "database",
      "label": "gold.*",
      "sublabel": "serving BI"
    }
