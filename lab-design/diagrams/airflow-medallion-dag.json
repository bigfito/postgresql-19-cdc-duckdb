          "label": "Tarea Airflow (spark-submit)"
        },
        "security": {
          "label": "Validación de datos"
        },
        "messagebus": {
          "label": "Job PySpark"
        },
        "database": {
          "label": "Capa Iceberg"
        },
        "external": {
          "label": "Tarea de control (sin job)"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "dag",
      "label": "Airflow 3.4"
    },
    {
      "id": "control",
      "label": "Estado de la corrida"
    },
    {
      "id": "spark",
      "label": "Spark 4.1.4"
    },
    {
      "id": "lake",
      "label": "Iceberg"
    }
  ],
  "mainPath": [
    "validateBronze",
    "runSilver",
    "validateSilver",
    "runGold",
    "validateGold",
    "maintenance"
