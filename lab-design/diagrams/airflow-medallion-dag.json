    },
    {
      "id": "runSilver",
      "lane": "dag",
      "col": 1,
      "type": "backend",
      "label": "bronze_to_silver",
      "sublabel": "SparkSubmit"
    },
    {
      "id": "validateSilver",
      "lane": "dag",
      "col": 2,
      "type": "security",
      "label": "validate_silver",
      "sublabel": "SCD2 y claves"
    },
    {
      "id": "runGold",
      "lane": "dag",
      "col": 3,
      "type": "backend",
      "label": "silver_to_gold",
      "sublabel": "SparkSubmit"
    },
    {
      "id": "validateGold",
      "lane": "dag",
      "col": 4,
      "type": "security",
      "label": "validate_gold",
      "sublabel": "filas, nulos, repetidos"
    },
    {
      "id": "maintenance",
      "lane": "dag",
      "col": 5,
      "type": "backend",
      "label": "iceberg_maintenance",
      "sublabel": "siempre al final"
    },
    {
      "id": "markFailed",
      "lane": "control",
      "col": 5,
      "type": "external",
      "label": "mark_run_failed",
      "sublabel": "solo si algo falló"
