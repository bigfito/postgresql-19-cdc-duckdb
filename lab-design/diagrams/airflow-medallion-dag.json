  "edges": [
    {
      "id": "t1",
      "from": "validateBronze",
      "to": "runSilver",
      "variant": "emphasis"
    },
    {
      "id": "t2",
      "from": "runSilver",
      "to": "validateSilver",
      "variant": "emphasis"
    },
    {
      "id": "t3",
      "from": "validateSilver",
      "to": "runGold",
      "variant": "emphasis"
    },
    {
      "id": "t4",
      "from": "runGold",
      "to": "validateGold",
      "variant": "emphasis"
    },
    {
      "id": "t5",
      "from": "validateGold",
      "to": "maintenance",
      "label": "all_done",
      "variant": "dashed"
    },
    {
      "id": "t6",
      "from": "maintenance",
      "to": "markFailed",
      "label": "one_failed",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "submit-silver",
      "from": "runSilver",
      "to": "jobSilver",
      "label": "spark-submit",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "submit-gold",
      "from": "runGold",
      "to": "jobGold",
      "label": "spark-submit",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "read-bronze",
      "from": "bronze",
      "to": "jobSilver",
      "label": "lee estado"
    },
    {
      "id": "write-silver",
      "from": "jobSilver",
      "to": "silver",
      "label": "MERGE"
    },
    {
      "id": "read-silver",
      "from": "silver",
      "to": "jobGold",
      "label": "lee vigentes"
    },
    {
      "id": "write-gold",
      "from": "jobGold",
      "to": "gold",
      "label": "overwrite"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Validaciones",
      "items": [
        "Cada validate_* consulta la capa de su mismo nombre",
        "Si una validación falla, no corren las tareas siguientes salvo el mantenimiento",
        "mark_run_failed espera a las seis tareas y solo corre si alguna falló: deja la corrida en error",
        "La capa siguiente conserva su último estado bueno"
      ]
    },
    {
      "dot": "emerald",
      "title": "Alcance de Airflow",
      "items": [
        "Orquesta los jobs PySpark por lotes; no toca Superset",
        "Flink CDC corre continuo, fuera del DAG",
        "Reejecutar el DAG es idempotente",
        "Corre cada 10 minutos y también se puede lanzar a mano"
      ]
    },
    {
      "dot": "violet",
      "title": "Mantenimiento",
      "items": [
        "Compacta Bronze (deletes de igualdad de Flink)",
        "Expira snapshots antiguos",
        "Corre siempre al final, aunque falle una validación"
      ]
    },
    {
      "dot": "cyan",
      "title": "Superset",
      "items": [
        "No forma parte del DAG",
        "Lee Gold a través de DuckDB en cada consulta",
        "Los gráficos los crea quien usa el laboratorio"
      ]
    }
  ]
}
