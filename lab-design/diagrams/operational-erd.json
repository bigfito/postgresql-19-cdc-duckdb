  "cards": [
    {
      "dot": "cyan",
      "title": "Claves",
      "items": [
        "movie_id, collection_id y keyword_id son claves naturales dispersas",
        "Los otros cinco IDs los asigna el dataset, desde 1; el nombre es UNIQUE",
        "La posición de cada relación es UNIQUE junto con movie_id"
      ]
    },
    {
      "dot": "rose",
      "title": "DELETE",
      "items": [
        "Borrar movie elimina sus 8 relaciones (ON DELETE CASCADE)",
        "Las entidades compartidas y los catálogos no se borran",
        "Todas las tablas usan REPLICA IDENTITY FULL"
      ]
    },
    {
      "dot": "amber",
      "title": "Tipos",
      "items": [
        "Solo tipos interoperables con Flink CDC, Iceberg, Spark y DuckDB",
        "Sin json, enum, arrays, money ni vectores",
        "NULL significa ausencia; nunca cero sintético"
      ]
    }
