  "cards": [
    {
      "dot": "emerald",
      "title": "Cabecera, Avance y Operaciones",
      "items": [
        "Cabecera: estado, semilla, conexiones a PostgreSQL y Bronze, e intervalo vigente",
        "Avance: películas insertadas sobre el total, barra de progreso, vivas en catalog, ritmo, pendientes y borradas",
        "Operaciones: contadores de INSERT, UPDATE y DELETE con su peso, errores y manuales"
      ]
    },
    {
      "dot": "amber",
      "title": "Últimas transacciones y Detalle",
      "items": [
        "Una fila por transacción: hora, operación, movie_id, título, filas, duración y estado en Bronze",
        "Bronze pasa de «pendiente» a «✓» con el tiempo transcurrido",
        "Detalle: desglose por tabla de la transacción seleccionada"
      ]
    },
    {
      "dot": "cyan",
      "title": "Teclas",
      "items": [
        "Espacio pausa o reanuda; + y - cambian el intervalo",
        "P abre el diálogo de pesos; M, el de operación manual",
        "↑ y ↓ recorren la lista; Q sale de la interfaz"
      ]
    }
  ]
