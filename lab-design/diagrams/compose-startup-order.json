  "cards": [
    {
      "dot": "orange",
      "title": "Jobs one-shot",
      "items": [
        "Terminan con código 0 y no se reinician",
        "depends_on usa service_completed_successfully",
        "Son idempotentes: se pueden relanzar",
        "volumes-init corre primero, como root, y prepara los directorios de datos"
      ]
    },
    {
      "dot": "emerald",
      "title": "Por qué el simulador va al final",
      "items": [
        "flink-cdc-submit termina con el pipeline en RUNNING",
        "Así los INSERT se capturan como streaming",
        "No como parte del snapshot inicial"
      ]
    },
    {
      "dot": "violet",
      "title": "Notas",
      "items": [
        "Airflow y Superset arrancan sin esperar a Spark ni a Gold",
        "Solo las corridas del DAG y los datasets los necesitan",
        "Todo vive en un único docker-compose.yml"
      ]
    }
  ]
